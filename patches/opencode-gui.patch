diff --git a/packages/app/src/runtime/plugin/screen-surface.ts b/packages/app/src/runtime/plugin/screen-surface.ts
new file mode 100644
index 0000000000..8af67dcb28
--- /dev/null
+++ b/packages/app/src/runtime/plugin/screen-surface.ts
@@ -0,0 +1,238 @@
+import { batch, createSignal, onCleanup, untrack, type Accessor } from "solid-js"
+import type { Comments, Composer, Files, LineRange, SessionScreen } from "@opencode/plugin/gui"
+import { useComments } from "@/composer/comments"
+import { createComposerEditorActions } from "@/composer/editor/actions"
+import { useComposerState } from "@/composer/persistence"
+import type { ComposerStateValue } from "@/composer/state"
+import { useLocal } from "@/providers/models/selection"
+import { useFile } from "@/workspaces/files/model"
+import { useWorkspaceLocation } from "@/workspaces/location"
+import {
+  createComposerWriteState,
+  transitionComposerWrite,
+  type ComposerWriteEffect,
+  type ComposerWriteEvent,
+} from "./composer-write-machine"
+
+/** What the composer view tells plugins about its prompt, once it renders. */
+export type ScreenPrompt = { quotable: Accessor<boolean>; focus: () => void; focused: () => boolean }
+
+/**
+ * The plugin-facing screen of one composer: its workspace files, its line comments and the prompt it edits. A session
+ * passes `isChild` so a subagent's composer takes no writes; a draft, which is never a child, does not.
+ */
+export function createScreenSurface(isChild: () => boolean) {
+  const file = useFile()
+  const comments = useComments()
+  const composer = useComposerState()
+  const local = useLocal()
+  const location = useWorkspaceLocation()
+  // The composer view is created after this surface and says whether it takes quotes and focuses its prompt.
+  const [prompt, setPrompt] = createSignal<ScreenPrompt>()
+
+  const files: Files = {
+    get root() {
+      return location().directory
+    },
+    ready: file.ready,
+    resolve: file.normalize,
+    absolute: file.absolute,
+    get: file.get,
+    missing: file.notFound,
+    sync: (path, options) => {
+      file.watch(path)
+
+      return file.load(path, options)
+    },
+    unwatch: file.unwatch,
+    exists: file.exists,
+    search: (query, options) =>
+      options?.kind === "any" ? file.searchFilesAndDirectories(query, options) : file.searchFiles(query, options),
+    selection: {
+      // SAFETY: the file model returns the view cache's selection for the path, which its schema types as a line range.
+      get: (path) => file.selectedLines(path) as LineRange | null | undefined,
+      set: (path, range) => void file.setSelectedLines(path, range),
+    },
+    scroll: {
+      get: (path) => ({
+        // SAFETY: the file model returns the view cache's offsets for the path, which its schema types as numbers.
+        top: file.scrollTop(path) as number | undefined,
+        // SAFETY: as above.
+        left: file.scrollLeft(path) as number | undefined,
+      }),
+      set(path, value) {
+        if (value.top !== undefined) file.setScrollTop(path, value.top)
+
+        if (value.left !== undefined) file.setScrollLeft(path, value.left)
+      },
+    },
+    tree: {
+      list: file.tree.children,
+      state: file.tree.state,
+      sync: (path, options) => (options?.force ? file.tree.refresh(path) : file.tree.list(path)),
+      expand: (path, options) => void file.tree.expand(path, options),
+      collapse: (path) => void file.tree.collapse(path),
+    },
+  }
+
+  const commentFile = (id: string) => comments.all().find((item) => item.id === id)?.file
+
+  const comment: Comments = {
+    list: (path) => (path ? comments.list(path) : comments.all()),
+    add: comments.add,
+    update(id, text) {
+      const path = commentFile(id)
+
+      if (path) comments.update(path, id, text)
+    },
+    remove(id) {
+      const path = commentFile(id)
+
+      if (path) comments.remove(path, id)
+    },
+    focus: { current: comments.focus, set: (value) => void comments.setFocus(value) },
+    active: { current: comments.active, set: (value) => void comments.setActive(value) },
+  }
+
+  // A write before the composer's draft loads would replace the stored draft, so it waits for the load and then applies
+  // to that prompt (`composer-write-machine.ts`). Later writes to it queue behind to keep call order.
+  const writes = { state: createComposerWriteState<ComposerStateValue>() }
+  // Events an effect raises synchronously, such as a write a queued write makes, wait behind that effect.
+  const queue: ComposerWriteEvent<ComposerStateValue>[] = []
+
+  const dispatchWrite = (event: ComposerWriteEvent<ComposerStateValue>) => {
+    queue.push(event)
+
+    if (queue.length === 1) untrack(drainWrites)
+  }
+
+  const drainWrites = () => {
+    const event = queue[0]
+
+    if (!event) return
+
+    try {
+      const next = transitionComposerWrite(writes.state, event)
+
+      writes.state = next.state
+      next.effects.forEach((effect) =>
+        Promise.try(() => runWrite(effect)).catch((cause: unknown) =>
+          console.error("[plugin] Composer write failed", cause),
+        ),
+      )
+    } finally {
+      queue.shift()
+    }
+
+    drainWrites()
+  }
+
+  const runWrite = (effect: ComposerWriteEffect<ComposerStateValue>) => {
+    if (effect.type === "apply") return effect.write(effect.target)
+
+    if (effect.type === "drain") return dispatchWrite({ type: "drain.next", target: effect.target })
+
+    if (effect.type === "observe")
+      return void effect.load.then(
+        // One batch, so the waiting writes land as one change.
+        () => batch(() => dispatchWrite({ type: "loaded", target: effect.target })),
+        (cause: unknown) => dispatchWrite({ type: "failed", target: effect.target, cause }),
+      )
+
+    console.error("[plugin] Composer draft load failed", effect.cause)
+  }
+
+  onCleanup(() => dispatchWrite({ type: "disposed" }))
+
+  const write = (apply: (draft: ComposerStateValue) => void) =>
+    dispatchWrite({
+      type: "write",
+      target: composer.capture(),
+      load: composer.ready() ? undefined : composer.ready.promise,
+      write: apply,
+    })
+
+  // A subagent's session has no composer, so its draft is never sent.
+  const edit = (apply: (draft: ReturnType<typeof createComposerEditorActions>) => void) => {
+    if (!isChild()) write((target) => apply(createComposerEditorActions(target.store)))
+  }
+
+  const pluginComposer: Composer = {
+    text: () =>
+      isChild()
+        ? ""
+        : composer
+            .capture()
+            .current()
+            .map((part) => ("content" in part ? part.content : ""))
+            .join(""),
+    insert(text) {
+      const value = text.replace(/\r\n?/g, "\n")
+
+      if (value) edit((draft) => draft.addText(value))
+    },
+    setText: (value) => edit((draft) => draft.setText(value.replace(/\r\n?/g, "\n"))),
+    model() {
+      const item = isChild() ? undefined : local.model.current()
+
+      if (!item) return
+
+      return { providerID: item.provider.id, modelID: item.id, variant: local.model.variant.current() }
+    },
+    setModel(model) {
+      const item = isChild()
+        ? undefined
+        : local.model.list().find((entry) => entry.provider.id === model.providerID && entry.id === model.modelID)
+
+      if (!item || (model.variant !== undefined && !Object.keys(item.variants ?? {}).includes(model.variant)))
+        return false
+      // As the model picker selects: the model first, then a variant chosen with it.
+      local.model.set({ providerID: model.providerID, modelID: model.modelID }, { recent: true })
+
+      if (model.variant !== undefined) local.model.variant.set(model.variant)
+
+      return true
+    },
+    setVariant(variant) {
+      if (isChild() || !local.model.current()) return false
+
+      if (variant !== undefined && !local.model.variant.list().includes(variant)) return false
+      local.model.variant.set(variant)
+
+      return true
+    },
+    attach: (part) => write((draft) => draft.context.add(part)),
+    attached: () =>
+      isChild()
+        ? []
+        : composer
+            .capture()
+            .context.items()
+            .flatMap((item) => (item.type === "file" ? [item.path] : [])),
+    quotable: () => !!prompt()?.quotable(),
+    focus(commentID, options) {
+      if (commentID === undefined) return prompt()?.focus()
+
+      // Behind the writes still waiting, so it finds a quote an `attach` just before it added.
+      write((draft) => {
+        const item = draft.context.items().find((entry) => entry.type === "quote" && entry.commentID === commentID)
+
+        if (item) draft.quoteComment.set(item.key, options?.anchor)
+      })
+    },
+    update: (id, patch) => write((draft) => draft.context.updateComment(id, patch)),
+    detach: (id) => write((draft) => draft.context.removeComment(id)),
+    focused: () => !!prompt()?.focused(),
+  }
+
+  const screen: SessionScreen = Object.freeze({
+    file: files,
+    comment,
+    composer: pluginComposer,
+  })
+
+  return {
+    screen,
+    bindPrompt: (value: ScreenPrompt) => setPrompt(() => value),
+  }
+}
